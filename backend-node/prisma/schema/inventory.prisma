model Warehouse {
  id        Int             @id @default(autoincrement())
  code      String          @unique @db.VarChar(32)
  name      String          @db.VarChar(160)
  address   String?         @db.VarChar(255)
  city      String?         @db.VarChar(100)
  country   String?         @db.VarChar(100)
  managerId Int?
  status    WarehouseStatus @default(ACTIVE)
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  manager          User?                 @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  stocks           WarehouseStock[]
  movements        StockMovement[]
  access           UserWarehouseAccess[]
  purchaseOrders   PurchaseOrder[]
  salesOrders      SalesOrder[]
  goodsReceipts    GoodsReceipt[]
  fulfillments     SalesFulfillment[]

  @@index([status])
  @@map("warehouses")
}

model UserWarehouseAccess {
  userId      Int
  warehouseId Int
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@map("user_warehouse_access")
}

model WarehouseStock {
  id                Int      @id @default(autoincrement())
  warehouseId       Int
  productId         Int
  quantity          Decimal  @default(0) @db.Decimal(14, 4)
  reservedQuantity  Decimal  @default(0) @db.Decimal(14, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, productId], name: "uq_warehouse_product_stock")
  @@index([productId])
  @@map("warehouse_stocks")
}

model StockMovement {
  id                 Int                @id @default(autoincrement())
  type               StockMovementType
  productId          Int
  warehouseId        Int
  quantity           Decimal            @db.Decimal(14, 4)
  resultingQuantity  Decimal            @db.Decimal(14, 4)
  unitCost           Decimal?           @db.Decimal(12, 2)
  referenceType      String?            @db.VarChar(40)
  referenceId        Int?
  notes              String?            @db.VarChar(500)
  createdById        Int?
  createdAt          DateTime           @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

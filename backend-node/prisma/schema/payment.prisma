enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

model Payment {
  id                   Int           @id @default(autoincrement())
  reference            String        @unique @default(uuid()) @db.VarChar(36)
  senderId             Int
  receiverId           Int
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @db.Char(3)
  status               PaymentStatus @default(PENDING)
  paymentMethod        String?       @db.VarChar(50)
  transactionReference String?       @unique @db.VarChar(255)
  description          String?       @db.VarChar(500)
  stripeCheckoutSessionId   String?  @unique @db.VarChar(255)
  stripePaymentIntentId     String?  @unique @db.VarChar(255)
  stripeDestinationAccountId String? @db.VarChar(255)
  attempts             PaymentAttempt[]
  stripeEvents         StripeEvent[]

  // Filled when a success or failure receipt has been generated.
  receiptId            Int?          @unique
  receipt              PaymentGeneration? @relation("PaymentReceipt", fields: [receiptId], references: [id], onDelete: Restrict)

  sender               User          @relation("PaymentSender", fields: [senderId], references: [id], onDelete: Restrict)
  receiver             User          @relation("PaymentReceiver", fields: [receiverId], references: [id], onDelete: Restrict)

  processedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

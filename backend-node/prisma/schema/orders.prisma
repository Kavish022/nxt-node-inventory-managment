model PurchaseOrder {
  id             Int                  @id @default(autoincrement())
  orderNumber    String               @unique @db.VarChar(40)
  supplierId     Int
  warehouseId    Int
  status         PurchaseOrderStatus  @default(DRAFT)
  subtotal       Decimal              @db.Decimal(12, 2)
  taxAmount      Decimal              @default(0) @db.Decimal(12, 2)
  discountAmount Decimal              @default(0) @db.Decimal(12, 2)
  total          Decimal              @db.Decimal(12, 2)
  notes          String?              @db.Text
  createdById    Int?
  approvedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy   User?               @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items       PurchaseOrderItem[]
  receipts    GoodsReceipt[]

  @@index([supplierId, status])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int     @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  quantity        Decimal @db.Decimal(14, 4)
  receivedQty     Decimal @default(0) @db.Decimal(14, 4)
  unitPrice       Decimal @db.Decimal(12, 2)
  taxRate         Decimal @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              Int      @id @default(autoincrement())
  receiptNumber   String   @unique @db.VarChar(40)
  purchaseOrderId Int
  warehouseId     Int
  notes           String?  @db.VarChar(500)
  createdById     Int?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             Int     @id @default(autoincrement())
  goodsReceiptId Int
  productId      Int
  quantity       Decimal @db.Decimal(14, 4)

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}

model SalesOrder {
  id             Int              @id @default(autoincrement())
  orderNumber    String           @unique @db.VarChar(40)
  customerId     Int
  warehouseId    Int
  status         SalesOrderStatus @default(DRAFT)
  subtotal       Decimal          @db.Decimal(12, 2)
  taxAmount      Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount Decimal          @default(0) @db.Decimal(12, 2)
  total          Decimal          @db.Decimal(12, 2)
  notes          String?          @db.Text
  createdById    Int?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("SalesOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items        SalesOrderItem[]
  fulfillments SalesFulfillment[]
  returns      SalesReturn[]

  @@index([customerId, status])
  @@index([createdAt])
  @@map("sales_orders")
}

model SalesOrderItem {
  id             Int     @id @default(autoincrement())
  salesOrderId   Int
  productId      Int
  quantity       Decimal @db.Decimal(14, 4)
  fulfilledQty   Decimal @default(0) @db.Decimal(14, 4)
  reservedQty    Decimal @default(0) @db.Decimal(14, 4)
  unitPrice      Decimal @db.Decimal(12, 2)
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

model SalesFulfillment {
  id             Int      @id @default(autoincrement())
  fulfillmentNo  String   @unique @db.VarChar(40)
  salesOrderId   Int
  warehouseId    Int
  notes          String?  @db.VarChar(500)
  createdById    Int?
  createdAt      DateTime @default(now())

  salesOrder SalesOrder             @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  warehouse  Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items      SalesFulfillmentItem[]

  @@index([salesOrderId])
  @@map("sales_fulfillments")
}

model SalesFulfillmentItem {
  id             Int     @id @default(autoincrement())
  fulfillmentId  Int
  productId      Int
  quantity       Decimal @db.Decimal(14, 4)

  fulfillment SalesFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@index([fulfillmentId])
  @@map("sales_fulfillment_items")
}

model SalesReturn {
  id           Int      @id @default(autoincrement())
  returnNumber String   @unique @db.VarChar(40)
  salesOrderId Int
  reason       String?  @db.VarChar(500)
  createdById  Int?
  createdAt    DateTime @default(now())

  salesOrder SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  items      SalesReturnItem[]

  @@index([salesOrderId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            Int     @id @default(autoincrement())
  salesReturnId Int
  productId     Int
  quantity      Decimal @db.Decimal(14, 4)

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)

  @@index([salesReturnId])
  @@map("sales_return_items")
}

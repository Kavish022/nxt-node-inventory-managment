model Category {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?   @db.Text
  parentId    Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id              Int           @id @default(autoincrement())
  sku             String        @unique @db.VarChar(64)
  barcode         String?       @unique @db.VarChar(64)
  name            String        @db.VarChar(180)
  description     String?       @db.Text
  categoryId      Int
  brand           String?       @db.VarChar(120)
  unitOfMeasure   String        @default("pcs") @db.VarChar(32)
  costPrice       Decimal       @db.Decimal(12, 2)
  sellingPrice    Decimal       @db.Decimal(12, 2)
  minStockLevel   Decimal       @default(0) @db.Decimal(14, 4)
  maxStockLevel   Decimal?      @db.Decimal(14, 4)
  reorderQuantity Decimal       @default(0) @db.Decimal(14, 4)
  status          ProductStatus @default(ACTIVE)
  createdById     Int?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy         User?              @relation("ProductCreator", fields: [createdById], references: [id], onDelete: SetNull)
  images            ProductImage[]
  stocks            WarehouseStock[]
  movements         StockMovement[]
  supplierProducts  SupplierProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems   SalesOrderItem[]

  @@index([categoryId, status])
  @@index([name])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String   @db.VarChar(500)
  altText   String?  @db.VarChar(160)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}
